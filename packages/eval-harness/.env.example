# =========================================================================
# packages/eval-harness/.env — eval runner + cross-model probe + reviewer
# =========================================================================
# `dotenv/config` resolves this file from the workspace CWD when you run
# `npm run eval --workspace @interpretive/eval-harness -- ...`. Mirror any
# keys here that you also need in packages/council/.env if you run the
# Council CLI.

# --- Provider API keys (set at least one; cross-model needs >=2) ---
# The default judge picks Anthropic > OpenAI > Gemini > OpenRouter in that
# order from whichever first key is present. For --provider=cross-model the
# runner builds a rotation of every provider with a key set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GLM_API_KEY=

# OpenRouter acts as a multi-provider gateway. If set AND the matching direct
# key (OPENAI/GEMINI/GLM) is absent, the runner routes that slot through
# OpenRouter — one key buys you GPT-5 + Gemini + GLM coverage for the
# cross-model probe.
OPENROUTER_API_KEY=

# --- Default judge model override ---
# Overrides the model string picked by loadLLMJudgeConfig() for the default
# (non-cross-model) judge path. Leave blank to take the provider's default.
LLM_JUDGE_MODEL=

# --- Reviewer pass (judge-validation/produce-reviewer-label.ts) ---
# Optional stronger model for the reviewer label pass; defaults to the same
# model as the judge if unset.
LLM_REVIEWER_MODEL=

# --- Cross-model probe per-slot model overrides ---
# The defaults in buildModelRotation() are reasonable mid-2026 pins; override
# here if OpenRouter or a provider has shifted model IDs.
LLM_MODEL_CLAUDE=
LLM_MODEL_GPT5=
LLM_MODEL_GEMINI=
LLM_MODEL_GLM=

# --- Langfuse traces (optional; eval-harness/src/trace-replay/sink-langfuse) ---
# When both PUBLIC + SECRET keys are present, --trace=langfuse pushes spans
# to Langfuse Cloud (or your self-hosted instance via LANGFUSE_BASE_URL).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_RELEASE=

# --- Inspect AI sidecar (packages/eval-harness/inspect-tasks/) ---
# Model id Inspect uses for the held-out judge regression. Format follows
# Inspect AI's provider/model convention (anthropic/<id>, openai/<id>, ...).
INSPECT_MODEL=anthropic/claude-opus-4-7

# --- Python sidecar interpreter ---
# Override the Python binary the bridge spawns. Defaults to the venv at
# inspect-tasks/.venv or dspy/.venv if present, else `python3`.
PYTHON=
