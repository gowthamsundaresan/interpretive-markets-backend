DIRECT_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
NETWORK=ritual
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=
RITUAL_RPC_URL=https://rpc.ritualfoundation.org
