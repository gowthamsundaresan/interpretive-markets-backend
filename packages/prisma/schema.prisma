generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Framework {
  id                String   @id
  uri               String
  author            String
  metadata          Bytes
  registeredAt      DateTime
  registeredAtBlock BigInt   @default(0)

  markets Market[]

  createdAt DateTime @default(now())
}

model Judge {
  imageDigest       String   @id
  signer            String
  enabled           Boolean  @default(true)
  registeredAt      DateTime
  registeredAtBlock BigInt   @default(0)

  markets Market[]

  createdAt DateTime @default(now())
}

model Market {
  id                 BigInt    @id
  question           String
  frameworkId        String
  framework          Framework @relation(fields: [frameworkId], references: [id])
  judgeDigest        String
  judge              Judge     @relation(fields: [judgeDigest], references: [imageDigest])
  modelId            String
  promptTemplateHash String
  dataSourceSpec     Bytes
  resolutionTime     DateTime
  creator            String
  createdAt          DateTime  @default(now())
  createdAtBlock     BigInt    @default(0)

  verdict Verdict?
}

enum ReExecStatus {
  pending
  verified
  disputed
}

model Verdict {
  marketId      BigInt   @id
  market        Market   @relation(fields: [marketId], references: [id])
  outcome       Int
  // 1e18-scaled, stored as decimal string to avoid float loss
  confidence    String
  verdictHash   String
  bundleRef     String
  signer        String
  postedAt      DateTime
  postedAtBlock BigInt   @default(0)

  reExecStatus    ReExecStatus @default(pending)
  reExecCheckedAt DateTime?
  reExecHash      String?
  disputed        Boolean      @default(false)
  disputedAt      DateTime?
  disputedAtBlock BigInt?

  bundle ReExecBundle?
}

model ReExecBundle {
  marketId       BigInt    @id
  verdict        Verdict   @relation(fields: [marketId], references: [marketId])
  ipfsCid        String
  eigenDABlobKey String?
  sizeBytes      Int
  fetchedAt      DateTime?

  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model EventLogs_FrameworkRegistered {
  address          String
  transactionHash  String
  transactionIndex Int
  blockNumber      BigInt
  blockHash        String
  blockTime        DateTime

  frameworkId String
  uri         String
  author      String
  metadata    String

  @@id([transactionHash, transactionIndex])
}

model EventLogs_JudgeRegistered {
  address          String
  transactionHash  String
  transactionIndex Int
  blockNumber      BigInt
  blockHash        String
  blockTime        DateTime

  imageDigest String
  signer      String

  @@id([transactionHash, transactionIndex])
}

model EventLogs_JudgeEnabledSet {
  address          String
  transactionHash  String
  transactionIndex Int
  blockNumber      BigInt
  blockHash        String
  blockTime        DateTime

  imageDigest String
  enabled     Boolean

  @@id([transactionHash, transactionIndex])
}

model EventLogs_MarketCreated {
  address          String
  transactionHash  String
  transactionIndex Int
  blockNumber      BigInt
  blockHash        String
  blockTime        DateTime

  marketId         String
  frameworkId      String
  judgeImageDigest String
  creator          String

  @@id([transactionHash, transactionIndex])
}

model EventLogs_VerdictPosted {
  address          String
  transactionHash  String
  transactionIndex Int
  blockNumber      BigInt
  blockHash        String
  blockTime        DateTime

  marketId  String
  signer    String
  bundleRef String

  @@id([transactionHash, transactionIndex])
}

model EventLogs_VerdictDisputed {
  address          String
  transactionHash  String
  transactionIndex Int
  blockNumber      BigInt
  blockHash        String
  blockTime        DateTime

  marketId String
  disputer String
  evidence String

  @@id([transactionHash, transactionIndex])
}
