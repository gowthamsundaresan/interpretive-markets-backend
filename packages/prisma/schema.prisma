generator client {
  provider      = "prisma-client-js"
  // native = local dev. debian-openssl-3.0.x = node:22-slim Docker images.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Core domain ---

model Framework {
  id                String   @id
  uri               String
  author            String
  metadata          Bytes
  registeredAt      DateTime
  registeredAtBlock BigInt   @default(0)

  markets Market[]

  createdAt DateTime @default(now())
}

// Owner-curated allowlist of TEE executor addresses permitted to resolve markets.
// Replaces the pre-Ritual `Judge` model (image-digest → signer); on Ritual the protocol
// attests workload identity, and `AttestedExecutorRegistry` overlays the executor allowlist.
model AttestedExecutor {
  executor          String   @id
  enabled           Boolean  @default(true)
  registeredAt      DateTime
  registeredAtBlock BigInt   @default(0)

  createdAt DateTime @default(now())
}

model Market {
  id             BigInt    @id
  question       String
  frameworkId    String
  framework      Framework @relation(fields: [frameworkId], references: [id])
  creator        String
  createdAt      DateTime  @default(now())
  createdAtBlock BigInt    @default(0)

  // Ritual L1 MarketInit (Phase 2). Populated by `seedMarkets` from `Market.get(marketId)`.
  sourceAllowlist   String[] @default([])
  dossierPathPrefix String   @default("")
  dossierSubjects   String[] @default([])
  resolutionTime    DateTime
  cliType           Int      @default(0)
  model             String   @default("")
  maxTurns          Int      @default(0)
  maxTokens         Int      @default(0)
  callbackGasLimit  BigInt   @default(0)
  investigationTtl  BigInt   @default(0)

  // Runtime state from on-chain Market.get(marketId).
  investigationJobId     String?
  investigationStartedAt BigInt?
  dossierCid             String?
  finalized              Boolean @default(false)
  malformed              Boolean @default(false)
  disputed               Boolean @default(false)

  verdict Verdict?
}

enum ReExecStatus {
  pending
  verified
  disputed
}

model Verdict {
  marketId BigInt @id
  market   Market @relation(fields: [marketId], references: [id])

  // Verdict struct (ADR-003 + Phase 2 ResolutionTypes.Verdict).
  outcome       Int
  confidenceBps Int
  drivingTier   Int
  subjectRef    String
  rationaleHash String
  verdictHash   String
  dossierCid    String

  // Provenance from chain events / receipts.
  // executor is recorded address(0) on-chain (ADR-005); watcher resolves from receipt off-chain.
  investigationExecutor        String?
  investigationAttestedAtBlock BigInt?
  judgmentExecutor             String?
  judgmentAttestedAtBlock      BigInt?

  finalizedAt      DateTime
  finalizedAtBlock BigInt   @default(0)

  // Consistency-audit state (Phase 7 watcher).
  auditStatus       ReExecStatus @default(pending)
  auditCheckedAt    DateTime?
  auditEvidenceHash String?

  // Dispute state — independent of audit (a malformed market can be disputed too).
  disputed        Boolean   @default(false)
  disputedAt      DateTime?
  disputedAtBlock BigInt?
}

// Markets that emitted `MalformedVerdict` and were left challengeable instead of finalized
// (ADR-009). Separate from `Verdict` so a market either has a verdict OR a malformation, never
// both ambiguous.
model MalformedVerdictRecord {
  marketId       BigInt   @id
  reason         String
  emittedAt      DateTime
  emittedAtBlock BigInt   @default(0)

  // Same dispute lifecycle as Verdict.
  disputed        Boolean   @default(false)
  disputedAt      DateTime?
  disputedAtBlock BigInt?
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// --- Event-log archives — durable source of truth for re-derivation ---

model EventLogs_FrameworkRegistered {
  address          String
  transactionHash  String
  transactionIndex Int
  blockNumber      BigInt
  blockHash        String
  blockTime        DateTime

  frameworkId String
  uri         String
  author      String
  metadata    String

  @@id([transactionHash, transactionIndex])
}

