# =========================================================================
# packages/council/.env — multi-agent verifier CLI
# =========================================================================
# Council's CLI loads this file via `dotenv/config`. Any provider keys the
# embedded Verifier or judge calls need MUST be here (the eval-harness env
# is NOT inherited at runtime — each workspace resolves its own .env).

# --- Provider API keys (mirror eval-harness; cross-model probe needs >=2) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GLM_API_KEY=
OPENROUTER_API_KEY=

# --- Cross-model rotation overrides ---
LLM_MODEL_CLAUDE=
LLM_MODEL_GPT5=
LLM_MODEL_GEMINI=
LLM_MODEL_GLM=

# --- Reviewer / default judge model (forwarded into produceLLMVerdict) ---
LLM_JUDGE_MODEL=
LLM_REVIEWER_MODEL=

# --- Langfuse traces (one span per agent node) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_RELEASE=

# --- Chain interaction (Arbiter's dispute filer dynamically imports the
# watcher's fileDispute). Keep the watcher's chain env in sync if you plan
# to run `council evolve` against testnet end-to-end. ---
WATCHER_PRIVATE_KEY=
RITUAL_RPC_URL=
DEPLOYMENT_FILE=

# --- Python sidecars (Inspect AI + DSPy) ---
INSPECT_MODEL=anthropic/claude-opus-4-7
DSPY_MODEL=anthropic/claude-opus-4-7
DSPY_CANDIDATES=8
PYTHON=
