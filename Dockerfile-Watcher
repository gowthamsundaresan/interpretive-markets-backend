FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ARG CI_BUILD_VERSION
ENV WATCHER_VERSION=$CI_BUILD_VERSION

COPY package.json package-lock.json* tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/prisma/package.json ./packages/prisma/package.json
COPY packages/watcher/package.json ./packages/watcher/package.json

RUN npm install --ignore-scripts

COPY packages/shared ./packages/shared
COPY packages/prisma ./packages/prisma
COPY packages/watcher ./packages/watcher

RUN npm run prisma:generate -w @interpretive/prisma
RUN npm run build -w @interpretive/watcher

WORKDIR /app/packages/watcher
CMD ["npx", "tsx", "src/index.ts"]
