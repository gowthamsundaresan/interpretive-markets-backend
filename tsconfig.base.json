{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"esModuleInterop": true,
		"moduleResolution": "node",
		"sourceMap": true,
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"declarationMap": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true
	}
}
