FROM node:22-slim

# Debian slim has libssl3 + ca-certificates baked in — Prisma's debian-openssl-3.0.x
# engine loads cleanly without the version-detection quirks Alpine has.
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ARG CI_BUILD_VERSION
ENV API_VERSION=$CI_BUILD_VERSION

COPY package.json package-lock.json* tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/prisma/package.json ./packages/prisma/package.json
COPY packages/api/package.json ./packages/api/package.json

RUN npm install --ignore-scripts

COPY packages/shared ./packages/shared
COPY packages/prisma ./packages/prisma
COPY packages/api ./packages/api

RUN npm run prisma:generate -w @interpretive/prisma
RUN npm run build -w @interpretive/api

EXPOSE 3000

WORKDIR /app/packages/api
CMD ["npx", "tsx", "src/index.ts"]
